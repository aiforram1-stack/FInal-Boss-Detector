DATABASE_URL=sqlite:///./var/forensic.db
EVIDENCE_STORAGE_ROOT=./var/evidence
MAX_UPLOAD_BYTES=104857600
UPLOAD_CHUNK_BYTES=1048576
ALLOWED_MEDIA_TYPES=image/jpeg,image/png,image/gif,image/webp,audio/mpeg,audio/wav,audio/flac,video/mp4,video/quicktime,video/webm
LOG_LEVEL=INFO
STRUCTURAL_ANALYSIS_ENABLED=true
STRUCTURAL_TOOL_TIMEOUT_SECONDS=30
STRUCTURAL_MAX_OUTPUT_BYTES=1048576
STRUCTURAL_RESULT_ROOT=./var/results
EXIFTOOL_BINARY=exiftool
FFPROBE_BINARY=ffprobe
MEDIAINFO_BINARY=mediainfo
REPORT_TEMPLATE_DIR=./packages/structural/src/forensic_structural/templates
# GIT_COMMIT may be set by an immutable build to a 40-character lowercase commit.

# Phase 4 Community Forensics worker. Local defaults are mock-only and perform
# no model download, CUDA execution, RunPod call, or real network request.
IMAGE_COMMUNITY_ENVIRONMENT=local
IMAGE_COMMUNITY_BACKEND=mock
IMAGE_COMMUNITY_MODEL_MANIFEST=./workers/image-community/model-manifest.yaml
IMAGE_COMMUNITY_MODEL_CACHE=/models/community-forensics
IMAGE_COMMUNITY_ALLOW_MODEL_DOWNLOAD=false
IMAGE_COMMUNITY_MAX_INPUT_BYTES=26214400
IMAGE_COMMUNITY_MAX_WIDTH=16384
IMAGE_COMMUNITY_MAX_HEIGHT=16384
IMAGE_COMMUNITY_MAX_PIXELS=40000000
IMAGE_COMMUNITY_MAX_DECODED_MEMORY_BYTES=160000000
IMAGE_COMMUNITY_DOWNLOAD_CHUNK_BYTES=65536
IMAGE_COMMUNITY_CONNECT_TIMEOUT_SECONDS=5
IMAGE_COMMUNITY_READ_TIMEOUT_SECONDS=20
IMAGE_COMMUNITY_TOTAL_TIMEOUT_SECONDS=30
IMAGE_COMMUNITY_ALLOWED_INPUT_HOSTS=
IMAGE_COMMUNITY_ALLOW_REDIRECTS=false
IMAGE_COMMUNITY_MAX_REDIRECTS=0
IMAGE_COMMUNITY_TEMP_ROOT=/tmp/forensic-image-community
IMAGE_COMMUNITY_DEVICE=cuda
IMAGE_COMMUNITY_PRECISION=float32
IMAGE_COMMUNITY_REQUIRE_CUDA=true
IMAGE_COMMUNITY_MIN_FREE_VRAM_BYTES=1073741824
# Set only by a digest-addressed image build; required by real production mode.
IMAGE_COMMUNITY_CONTAINER_DIGEST=
RUN_GPU_TESTS=0
