{
  "additionalProperties": true,
  "properties": {
    "case_id": {
      "format": "uuid",
      "title": "Case Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "download_url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Download Url",
      "type": "string"
    },
    "evidence_id": {
      "format": "uuid",
      "title": "Evidence Id",
      "type": "string"
    },
    "expected_byte_length": {
      "minimum": 0,
      "title": "Expected Byte Length",
      "type": "integer"
    },
    "expected_mime_type": {
      "maxLength": 127,
      "minLength": 1,
      "title": "Expected Mime Type",
      "type": "string"
    },
    "expected_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Expected Sha256",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "requested_detector_name": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Requested Detector Name",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^1\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "run_id",
    "case_id",
    "evidence_id",
    "requested_detector_name",
    "download_url",
    "expected_sha256",
    "expected_byte_length",
    "expected_mime_type",
    "created_at",
    "expires_at"
  ],
  "title": "DetectorJob",
  "type": "object"
}
