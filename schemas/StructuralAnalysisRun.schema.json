    "ArtifactReference": {
      "additionalProperties": true,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "exact_parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Exact Parameters",
          "type": "object"
        },
        "kind": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "lossy": {
          "title": "Lossy",
          "type": "boolean"
        },
        "mime_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Mime Type",
          "type": "string"
        },
        "parent_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Parent Sha256",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^1\\.[0-9]+$",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "storage_uri": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Storage Uri",
          "type": "string"
        },
        "tool_version": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Tool Version",
          "type": "string"
        },
        "transformation_tool": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Transformation Tool",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "artifact_id",
        "kind",
        "storage_uri",
        "sha256",
        "byte_length",
        "mime_type",
        "parent_sha256",
        "transformation_tool",
        "tool_version",
        "lossy"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
