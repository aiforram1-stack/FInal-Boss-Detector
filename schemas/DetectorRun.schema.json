{
  "$defs": {
    "DetectorIdentity": {
      "additionalProperties": true,
      "properties": {
        "checkpoint_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Checkpoint Sha256",
          "type": "string"
        },
        "container_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Container Digest",
          "type": "string"
        },
        "detector_name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Detector Name",
          "type": "string"
        },
        "detector_version": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Detector Version",
          "type": "string"
        },
        "model_revision": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Model Revision",
          "type": "string"
        },
        "repository_commit": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Repository Commit",
          "type": "string"
        },
        "repository_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Repository Url",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^1\\.[0-9]+$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "detector_name",
        "detector_version",
        "repository_url",
        "repository_commit",
        "container_digest",
        "model_revision",
        "checkpoint_sha256"
      ],
      "title": "DetectorIdentity",
      "type": "object"
    },
    "DetectorRunStatus": {
      "enum": [
        "PENDING",
        "QUEUED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "TIMED_OUT",
        "CANCELLED"
      ],
      "title": "DetectorRunStatus",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "properties": {
    "case_id": {
      "format": "uuid",
      "title": "Case Id",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "detector": {
      "$ref": "#/$defs/DetectorIdentity"
    },
    "error_code": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "error_message": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Message"
    },
    "evidence_id": {
      "format": "uuid",
      "title": "Evidence Id",
      "type": "string"
    },
    "external_job_id": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "External Job Id"
    },
    "input_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^1\\.[0-9]+$",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/DetectorRunStatus"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "evidence_id",
    "detector",
    "status",
    "input_sha256",
    "created_at"
  ],
  "title": "DetectorRun",
  "type": "object"
}
